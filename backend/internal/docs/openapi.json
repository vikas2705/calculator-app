{
  "openapi": "3.0.3",
  "info": {
    "title": "Calculator API",
    "version": "1.0.0",
    "description": "A small REST service that performs one arithmetic operation per request.\n\nAll numbers are IEEE-754 double-precision floats (about 15–17 significant digits). Results are always finite: a result too large to represent returns `OVERFLOW`, and a mathematically undefined result returns `UNDEFINED_RESULT`. Negative zero is returned as `0`.\n\nEvery error response has the same shape: `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}`. Clients should branch on `code`; `message` is human-readable and may change."
  },
  "tags": [
    { "name": "Calculator" },
    { "name": "System" }
  ],
  "paths": {
    "/api/v1/calculate": {
      "post": {
        "tags": ["Calculator"],
        "summary": "Perform one operation",
        "description": "| operation | operands | result |\n|---|---|---|\n| `add` | `[a, b]` | a + b |\n| `subtract` | `[a, b]` | a − b |\n| `multiply` | `[a, b]` | a × b |\n| `divide` | `[a, b]` | a ÷ b |\n| `power` | `[a, b]` | a raised to the power b |\n| `sqrt` | `[a]` | √a |\n| `percentage` | `[a]` | a ÷ 100 |",
        "operationId": "calculate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CalculateRequest" },
              "examples": {
                "add": { "summary": "2 + 3", "value": { "operation": "add", "operands": [2, 3] } },
                "subtract": { "summary": "10 − 4", "value": { "operation": "subtract", "operands": [10, 4] } },
                "multiply": { "summary": "6 × 7", "value": { "operation": "multiply", "operands": [6, 7] } },
                "divide": { "summary": "10 ÷ 4", "value": { "operation": "divide", "operands": [10, 4] } },
                "power": { "summary": "2 ^ 10", "value": { "operation": "power", "operands": [2, 10] } },
                "sqrt": { "summary": "√9", "value": { "operation": "sqrt", "operands": [9] } },
                "percentage": { "summary": "50%", "value": { "operation": "percentage", "operands": [50] } },
                "divisionByZero": { "summary": "1 ÷ 0 (error)", "value": { "operation": "divide", "operands": [1, 0] } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result of the operation.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalculateResponse" },
                "example": { "result": 2.5 }
              }
            }
          },
          "400": {
            "description": "The request is malformed: invalid JSON, an unknown operation, or wrong operands.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "invalidJson": { "value": { "error": { "code": "INVALID_JSON", "message": "Request body must be a single JSON object, e.g. {\"operation\":\"add\",\"operands\":[1,2]}." } } },
                  "invalidOperation": { "value": { "error": { "code": "INVALID_OPERATION", "message": "\"operation\" must be one of: add, divide, multiply, percentage, power, sqrt, subtract." } } },
                  "invalidOperands": { "value": { "error": { "code": "INVALID_OPERANDS", "message": "\"sqrt\" needs exactly 1 operand(s) in \"operands\"." } } }
                }
              }
            }
          },
          "405": {
            "description": "Only POST is allowed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": { "code": "METHOD_NOT_ALLOWED", "message": "Method GET is not allowed. Use POST." } }
              }
            }
          },
          "413": {
            "description": "The request body is larger than 1024 bytes.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": { "code": "PAYLOAD_TOO_LARGE", "message": "Request body must not exceed 1024 bytes." } }
              }
            }
          },
          "422": {
            "description": "The request is valid, but the maths has no usable answer.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "divisionByZero": { "summary": "1 ÷ 0, or 0 ^ −1", "value": { "error": { "code": "DIVISION_BY_ZERO", "message": "Cannot divide by zero." } } },
                  "negativeSqrt": { "summary": "√−1", "value": { "error": { "code": "NEGATIVE_SQRT", "message": "Cannot take the square root of a negative number." } } },
                  "undefinedResult": { "summary": "(−8) ^ 0.5", "value": { "error": { "code": "UNDEFINED_RESULT", "message": "The result is undefined." } } },
                  "overflow": { "summary": "10 ^ 400", "value": { "error": { "code": "OVERFLOW", "message": "The result is too large." } } }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": { "code": "INTERNAL_ERROR", "message": "Something went wrong." } }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Liveness check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Operation": {
        "type": "string",
        "enum": ["add", "divide", "multiply", "percentage", "power", "sqrt", "subtract"],
        "description": "`sqrt` and `percentage` take one operand; all others take two."
      },
      "CalculateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "operands"],
        "properties": {
          "operation": { "$ref": "#/components/schemas/Operation" },
          "operands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "number", "format": "double" },
            "description": "Finite numbers. Must contain exactly as many items as the operation takes. `null` is not allowed."
          }
        }
      },
      "CalculateResponse": {
        "type": "object",
        "required": ["result"],
        "properties": {
          "result": { "type": "number", "format": "double", "description": "Always finite. Never negative zero." }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_JSON",
          "INVALID_OPERATION",
          "INVALID_OPERANDS",
          "PAYLOAD_TOO_LARGE",
          "DIVISION_BY_ZERO",
          "NEGATIVE_SQRT",
          "UNDEFINED_RESULT",
          "OVERFLOW",
          "METHOD_NOT_ALLOWED",
          "NOT_FOUND",
          "INTERNAL_ERROR"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "$ref": "#/components/schemas/ErrorCode" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
